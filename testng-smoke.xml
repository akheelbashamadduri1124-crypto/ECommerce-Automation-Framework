<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="ECommerce Smoke Suite" parallel="classes" thread-count="3">

    <listeners>
        <listener class-name="com.ecommerce.listeners.TestListener"/>
    </listeners>

    <test name="Smoke Tests">

        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
            <class name="com.ecommerce.tests.LoginTest"/>
            <class name="com.ecommerce.tests.CheckoutTest"/>
        </classes>

    </test>

</suite>